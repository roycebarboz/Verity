# Provider key for the default models (LiteLLM reads the key for whichever provider a model uses)
OPENAI_API_KEY=sk-...

# Per-agent chat models (LiteLLM model names). Defaults shown; uncomment to override.
# BOUNCER_MODEL=gpt-4.1-nano
# LIBRARIAN_MODEL=gpt-4.1-nano
# DRAFTER_MODEL=gpt-4.1-mini
# VERIFIER_MODEL=gpt-5-mini
# DISPATCHER_MODEL=gpt-4.1-nano

# Datadog
DD_API_KEY=
DD_APP_KEY=
DD_SITE=us5.datadoghq.com
DD_LLMOBS_ENABLED=1
DD_LLMOBS_ML_APP=verity
DD_SERVICE=verity-backend
DD_ENV=dev

# AWS (only needed for deployment — not required for local dev)
AWS_REGION=us-east-1
DYNAMODB_TABLE=verity-audit
S3_CHROMA_BUCKET=

# Reranker: "qwen" (default; needs models/Qwen3-Reranker-0.6B and `pip install -e backend[rerank]`) or "none"
RERANKER_MODE=qwen
